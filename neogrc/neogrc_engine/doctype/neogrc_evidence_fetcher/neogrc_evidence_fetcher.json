  },
  {
   "fieldname": "sb_exec",
   "fieldtype": "Section Break",
   "label": "Execution"
  },
  {
   "fieldname": "handler",
   "fieldtype": "Data",
   "label": "Handler",
   "description": "Dotted Python path, or a script filename relative to the connector's script root.",
   "depends_on": "eval:doc.handler_mode!='Query'",
   "mandatory_depends_on": "eval:doc.handler_mode!='Query'"
  },
  {
   "fieldname": "arguments",
   "fieldtype": "Small Text",
   "label": "Arguments",
   "description": "One argument per line. Passed verbatim; no shell expansion is performed."
  },
  {
   "fieldname": "cb_exec",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "output_format",
   "fieldtype": "Select",
   "label": "Output Format",
   "options": "JSON\nText",
   "default": "JSON"
  },
  {
   "fieldname": "timeout",
   "fieldtype": "Int",
   "label": "Timeout (s)",
   "default": "0",
   "description": "0 inherits the connector timeout."
  },
  {
   "fieldname": "sb_meta",
   "fieldtype": "Section Break",
   "label": "Documentation"
  },
  {
