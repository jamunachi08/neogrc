   "fieldname": "controls",
   "fieldtype": "Table",
   "label": "Controls",
   "options": "NeoGRC Fetcher Control Link"
  },
  {
   "fieldname": "sb_rules",
   "fieldtype": "Section Break",
   "label": "Automated Validation"
  },
  {
   "fieldname": "validation_rules",
   "fieldtype": "Table",
   "label": "Validation Rules",
   "options": "NeoGRC Validation Rule",
   "description": "Evaluated against fetcher output. All rules must pass for the evaluation to be recorded as pass."
  },
  {
   "fieldname": "emit_findings",
   "fieldtype": "Check",
   "label": "Emit Findings",
   "default": "1",
   "description": "When enabled, each run converts validation results into NeoGRC Finding records."
  },
  {
   "fieldname": "sb_state",
   "fieldtype": "Section Break",
   "label": "State"
  },
  {
   "fieldname": "last_run",
   "fieldtype": "Datetime",
   "label": "Last Run",
   "read_only": 1
  },
  {
   "fieldname": "last_status",
   "fieldtype": "Select",
   "label": "Last Status",
   "options": "\nSuccess\nPartial\nFailed\nAuth Error\nRate Limited\nNot Installed",
   "read_only": 1
  },
  {
   "fieldname": "handler_mode",
   "fieldtype": "Select",
   "label": "Handler Mode",
   "options": "Script\nQuery",
   "default": "Script",
   "in_list_view": 1,
   "description": "Script runs the connector handler. Query runs a declarative DocType query with no code."
  },
  {
   "fieldname": "sb_query",
   "fieldtype": "Section Break",
   "label": "Evidence Query",
   "depends_on": "eval:doc.handler_mode=='Query'",
   "description": "Declarative evidence from a DocType already in this site. No script is deployed."
  },
  {
   "fieldname": "query_doctype",
   "fieldtype": "Link",
   "options": "DocType",
   "label": "Source DocType",
   "mandatory_depends_on": "eval:doc.handler_mode=='Query'"
  },
  {
   "fieldname": "query_filters",
   "fieldtype": "Code",
   "options": "JSON",
   "label": "Filters (JSON)",
   "description": "Frappe filter object. Supports the tokens \"@today\" and [\"<\", \"@days_ago:90\"]. Field names are validated against the DocType."
  },
  {
   "fieldname": "cb_query",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "query_condition",
   "fieldtype": "Select",
   "label": "Pass Condition",
   "options": "COUNT_EQUALS_ZERO\nCOUNT_LTE_THRESHOLD\nCOUNT_GTE_THRESHOLD\nALL_ROWS_FIELD_SET\nALL_ROWS_FIELD_EQUALS\nNO_ROW_OLDER_THAN_DAYS",
   "default": "COUNT_EQUALS_ZERO"
  },
  {
   "fieldname": "field_to_check",
   "fieldtype": "Data",
   "label": "Field to Check",
   "depends_on": "eval:['ALL_ROWS_FIELD_SET','ALL_ROWS_FIELD_EQUALS','NO_ROW_OLDER_THAN_DAYS'].includes(doc.query_condition)"
  },
  {
   "fieldname": "expected_value",
   "fieldtype": "Data",
   "label": "Expected Value",
   "depends_on": "eval:doc.query_condition=='ALL_ROWS_FIELD_EQUALS'"
  },
  {
   "fieldname": "threshold_value",
   "fieldtype": "Int",
   "label": "Threshold",
   "depends_on": "eval:['COUNT_LTE_THRESHOLD','COUNT_GTE_THRESHOLD'].includes(doc.query_condition)"
  },
  {
   "fieldname": "tolerance_days",
   "fieldtype": "Int",
   "label": "Tolerance (days)",
   "depends_on": "eval:doc.query_condition=='NO_ROW_OLDER_THAN_DAYS'"
  }
 ],
