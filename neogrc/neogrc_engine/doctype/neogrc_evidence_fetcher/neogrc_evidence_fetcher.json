  {
   "fieldname": "dependencies",
   "fieldtype": "Small Text",
   "label": "Dependencies"
  },
  {
   "fieldname": "tags",
   "fieldtype": "Small Text",
   "label": "Tags"
  },
  {
   "fieldname": "sb_controls",
   "fieldtype": "Section Break",
   "label": "Control Coverage"
  },
