   "default": "1"
  },
  {
   "fieldname": "attach_artifacts_to_run",
   "fieldtype": "Check",
   "label": "Attach Artifacts to Evidence Run",
   "default": "1"
  },
  {
   "fieldname": "sb_residency",
   "fieldtype": "Section Break",
   "label": "Data Residency & Privacy"
  },
  {
   "fieldname": "residency_mode",
   "fieldtype": "Select",
   "label": "Residency Mode",
   "options": "On-Premise Only\nOn-Premise + Approved Cloud\nUnrestricted",
   "default": "On-Premise Only",
   "description": "On-Premise Only blocks all outbound connector and AI calls to non-allow-listed hosts."
  },
  {
   "fieldname": "allowed_egress_hosts",
   "fieldtype": "Small Text",
   "label": "Allowed Egress Hosts",
   "description": "One host per line. Enforced when residency mode is not Unrestricted."
  },
  {
   "fieldname": "cb_residency",
