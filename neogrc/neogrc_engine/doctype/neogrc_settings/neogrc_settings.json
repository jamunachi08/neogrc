   "fieldtype": "Section Break",
   "label": "General"
  },
  {
   "fieldname": "canonical_framework",
   "fieldtype": "Link",
   "label": "Canonical Control Framework",
   "options": "NeoGRC Framework",
   "description": "Framework used as the internal control vocabulary. All crosswalks resolve through it. Set to NCC by after_install once the frameworks are seeded; left empty here because Frappe creates this Single during install, before any framework exists."
  },
  {
   "fieldname": "schema_version",
   "fieldtype": "Data",
   "label": "Finding Schema Version",
   "default": "1.0.0",
   "read_only": 1
  },
  {
   "fieldname": "cb_general",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Evidence Automation Enabled",
   "default": "1"
  },
  {
   "fieldname": "default_run_timeout",
   "fieldtype": "Int",
   "label": "Default Fetcher Timeout (s)",
   "default": "300"
  },
  {
   "fieldname": "sb_storage",
   "fieldtype": "Section Break",
   "label": "Evidence Storage & Retention"
  },
  {
   "fieldname": "evidence_base_path",
   "fieldtype": "Data",
   "label": "Evidence Base Path",
   "description": "Absolute path for collected evidence. Left empty at install and resolved to the site's private files directory, which is writable on managed hosting. Set it explicitly only if you have a dedicated evidence volume."
  },
  {
   "fieldname": "artifact_retention_days",
   "fieldtype": "Int",
   "label": "Artifact Retention (days)",
   "default": "1095"
  },
