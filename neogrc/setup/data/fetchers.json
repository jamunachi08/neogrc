[
 {
  "fetcher_id": "EVD-ERP-2FA",
  "fetcher_name": "Desk Two-Factor Authentication",
  "connector": "erpnext-internal",
  "handler": "neogrc.engine.internal_fetchers.two_factor_status",
  "enabled": 1,
  "description": "Enumerates enabled desk users and whether MFA is enforced for each.",
  "instructions": "Compare System Settings > Enable Two Factor Authentication against the enabled System User list.",
  "tags": "identity,mfa",
  "controls": [
   {
    "control_framework": "NCC",
    "control_id": "IAM-02",
    "severity": "critical"
   },
   {
    "control_framework": "NCC",
    "control_id": "IAM-01",
    "severity": "critical"
   },
   {
    "control_framework": "FEDRAMP-20X-KSI",
    "control_id": "IAM-02",
    "severity": "critical"
   }
  ],
  "validation_rules": [
   {
    "rule_type": "JSON Path",
    "pattern": "users_without_2fa",
    "logic": "VALUE_LTE_EXPECTED",
    "severity_on_fail": "critical",
    "expected_value": "0",
    "message_on_fail": "One or more desk users can authenticate without a second factor"
   }
  ]
 },
 {
  "fetcher_id": "EVD-ERP-PRIV",
