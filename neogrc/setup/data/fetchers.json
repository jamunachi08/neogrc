 {
  "fetcher_id": "EVD-BLOCK-ENC",
  "fetcher_name": "Block Storage Encryption",
  "connector": "aws-inspector",
  "handler": "block_storage_encryption_status.sh",
  "enabled": 0,
  "description": "EBS and EFS encryption-at-rest status, including the account default.",
  "instructions": "aws ec2 get-ebs-encryption-by-default; aws ec2 describe-volumes; aws efs describe-file-systems",
  "dependencies": "aws-cli\njq",
  "tags": "encryption,storage",
  "controls": [
   {
    "control_framework": "NCC",
    "control_id": "CRY-01",
    "severity": "critical"
   },
   {
    "control_framework": "FEDRAMP-20X-KSI",
    "control_id": "SVC-03",
    "severity": "critical"
   }
  ],
  "validation_rules": [
   {
    "rule_type": "Regex Capture",
    "pattern": "\"total_storage\":\\s*(\\d+),\\s*\"encrypted_storage\":\\s*(\\d+)",
    "logic": "GROUP1_EQUALS_GROUP2",
    "severity_on_fail": "critical",
    "message_on_fail": "Not every block storage volume is encrypted at rest"
   }
  ]
 },
